# === SENTINEL Environment Configuration ===
#
# Copy to `.env` and fill in. `.env` is gitignored and must NEVER be committed
# — it holds live credentials for Copernicus and CDS.
#
# Every key below is read by code somewhere in this repo. Keys that were only
# ever read by the dead OceanTrace half of the old merged config have been
# removed rather than carried along, because a key that nothing reads is worse
# than no key: it makes a missing integration look configured.
#
# ── Which values are actually required ────────────────────────────────────
# To run the DEMO (archive browser + Tier-A detection + drift):
#   CDSE_CLIENT_ID, CDSE_CLIENT_SECRET      (archive search, GeoTIFF ingest)
#   CDSAPI_URL, CDSAPI_KEY                  (ERA5 winds — drift will not run without wind)
#   COPERNICUSMARINE_SERVICE_USERNAME/_PASSWORD  (CMEMS GLORYS12 currents)
# Without the CDS keys the drift service fails closed with a typed error. It
# does NOT quietly substitute synthetic wind. See docs/DATA_PROVENANCE.md.

# ── Database ──────────────────────────────────────────────────────────────
# Inside docker compose the host is `db`. For NATIVE runs (the recommended
# mode on this machine) use 127.0.0.1.
DATABASE_URL=postgresql+asyncpg://sentinel:sentinel_secret@127.0.0.1:5432/sentinel
DB_USER=sentinel
DB_PASSWORD=sentinel_secret
DB_PORT=5432

# ── Redis ─────────────────────────────────────────────────────────────────
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_BROKER_URL=redis://127.0.0.1:6379/1
REDIS_RESULT_BACKEND=redis://127.0.0.1:6379/2
REDIS_PORT=6379

# ── API gateway ───────────────────────────────────────────────────────────
API_PORT=8000
API_HOST=0.0.0.0
SENTINEL_API_VERSION=v1
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
JWT_SECRET=change-me-too
JWT_ALGORITHM=HS256
JWT_EXPIRE_SECONDS=86400
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
RESULT_TTL_SECONDS=86400
ENV=development

# ── Inter-service URLs ────────────────────────────────────────────────────
# NATIVE runs use 127.0.0.1. `docker-compose.override.yml` rewrites these to
# `sentinel-*` for compose. Do NOT put `sentinel-*` hostnames here: natively
# they do not resolve and every gateway proxy returns an opaque 500.
INGEST_SERVICE_URL=http://127.0.0.1:8001
DETECT_SERVICE_URL=http://127.0.0.1:8002
DRIFT_SERVICE_URL=http://127.0.0.1:8003
ATTRIBUTE_SERVICE_URL=http://127.0.0.1:8004
INTEL_SERVICE_URL=http://127.0.0.1:8005

# An ERA5 pull plus a 64-member ensemble is routinely 60-180 s, so the drift
# proxy gets its own generous timeout rather than inheriting a 30 s default.
DRIFT_PROXY_TIMEOUT=600
DETECT_PROXY_TIMEOUT=300
# Upload + inference on a ~1 GB scene.
DETECT_UPLOAD_TIMEOUT=900
ARCHIVE_PROXY_TIMEOUT=120

# ── Storage ───────────────────────────────────────────────────────────────
SENTINEL_DATA_DIR=./data
SYNTHETIC_DATA_DIR=./data/synthetic
OCEAN_STORAGE=./data/ocean
WIND_STORAGE=./data/wind
SENTINEL1_STORAGE=./data/sar
CASE_FILE_OUTPUT_DIR=./data/case_files

# ── Copernicus Data Space (CDSE) — Sentinel-1 SAR ─────────────────────────
# Powers the archive browser and GeoTIFF ingest via the Sentinel Hub Process
# API. The OData *download* endpoint rejects this token ("audience not
# allowed"); the Process API is the supported path. See docs/VERIFICATION.md §2.
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=
CDSE_TOKEN_URL=https://identity.dataspace.copernicus.eu/auth/realms/CDSE/protocol/openid-connect/token
CDSE_CATALOG_URL=https://catalogue.dataspace.copernicus.eu/odata/v1
CDSE_PROCESS_URL=https://sh.dataspace.copernicus.eu/api/v1/process
# Only needed for the WMS path, which is not used.
CDSE_WMS_INSTANCE_ID=

# ── ERA5 winds (CDS) ──────────────────────────────────────────────────────
# Drift REQUIRES wind: OpenOil refuses to run on currents alone. The licence
# must be accepted on the CDS account or every request 403s.
#   https://cds.climate.copernicus.eu/datasets/reanalysis-era5-single-levels?tab=download
CDSAPI_URL=https://cds.climate.copernicus.eu/api
CDSAPI_KEY=

# ── CMEMS currents (Copernicus Marine) ────────────────────────────────────
# The client reads the COPERNICUSMARINE_* names. The older CMEMS_USER/CMEMS_PASS
# pair was a duplicate under a different scheme and is gone.
COPERNICUSMARINE_SERVICE_USERNAME=
COPERNICUSMARINE_SERVICE_PASSWORD=
CMEMS_DATASET_PATH=cmems_mod_glo_phy_my_0.083deg_P1D-m
COPERNICUS_MARINE_PRODUCT_ID=GLOBAL_MULTIYEAR_PHY_001_030
COPERNICUS_MARINE_VARIABLES=uo,vo

# ── GFS winds (fallback / live operations) ────────────────────────────────
# GFS_OPENDAP_URL is DEAD — NOAA retired the OPeNDAP service (SCN 25-81) and
# it now returns an HTML page. The replacement is the NOMADS server-side
# subsetting filter, which returns ~1 KB instead of ~30 MB for a small box.
# GFS retains ~10 days, so historical cases must use ERA5.
GFS_THREDDS_URL=https://nomads.ncep.noaa.gov/cgi-bin/filter_gfs_0p25.pl
GFS_OPENDAP_URL=

# ── AIS ───────────────────────────────────────────────────────────────────
# AISStream is WebSocket-only; AIS_BASE_URL is not a REST endpoint.
# The feed is TERRESTRIAL: verified 48 messages globally in 13 s and ZERO over
# the Indian Ocean in 40 s. There is no free historical AIS for 2020 Mauritius.
AIS_API_KEY=
AISHUB_API_KEY=
AIS_BASE_URL=https://services.aisstream.io
# Legacy parquet path. `data/ais_demo.csv` was synthetic and has been deleted;
# this is kept only so the old attribute-service code path resolves to nothing
# rather than to a file that would be mistaken for real vessels.
AIS_PARQUET_PATH=

# ── Synthetic-data gates — ALL DEFAULT TO OFF, and off means FAIL ─────────
#
# These are opt-in and deliberately separate. An unset or misspelled value is
# FALSE: a typo must never open a gate.
#
# ALLOW_SYNTHETIC_FORCING
#   Lets CMEMS/ERA5 fall back to clearly-labelled synthetic forcing when the
#   real source is unavailable. When unset, the drift service raises a typed
#   provenance error instead. docs/VERIFICATION.md §9.2 records the failure
#   this prevents: an ERA5 outage silently degraded to synthetic wind and the
#   run *succeeded and returned invented numbers*.
#
# ALLOW_SYNTHETIC_AIS  (requires SENTINEL_DEMO_MODE as well)
#   Permits simulated vessel tracks, and ONLY inside NO_REAL_COVERAGE_BOXES and
#   outside any coastal carve-out where real receivers exist. Every record is
#   stamped provenance="synthetic_mock".
#
# SENTINEL_DEMO_MODE
#   Master switch for demo behaviour. Alone it is not enough for AIS.
#
# ALLOW_SYNTHETIC_TRAINING
#   Permits scripts/synthetic_train.py to write benchmark fixtures. Training
#   never generates synthetic samples implicitly under any setting.
ALLOW_SYNTHETIC_FORCING=false
ALLOW_SYNTHETIC_AIS=false
SENTINEL_DEMO_MODE=false
ALLOW_SYNTHETIC_TRAINING=false

# ── Ingest ────────────────────────────────────────────────────────────────
INGEST_POLL_INTERVAL_MINUTES=6
INGEST_INTERVAL_HOURS=1

# ── Detect ────────────────────────────────────────────────────────────────
# MODEL_CHECKPOINT is the Tier-B UNet++ checkpoint. With no checkpoint the
# service reports model_status="untrained" and emits NO probabilities — it does
# not fall back to a random-init forward pass. The Tier-A deterministic
# detector is the default and needs no weights.
MODEL_CHECKPOINT=checkpoints/best_model.pth
MODEL_NAME=unetpp_scse_resnet34
ENCODER_NAME=resnet34
MODEL_WEIGHTS_PATH=/app/app/models/weights/unetpp_scse_best.pth
DETECT_BATCH_SIZE=4
DETECT_TILE_SIZE=1024
DETECT_OVERLAP=192
DEVICE=auto
IN_CHANNELS=6
IMAGE_SIZE=512
NUM_CLASSES=2

# ── Training (CPU / MPS / CUDA auto-detected) ─────────────────────────────
TRAIN_EPOCHS=100
TRAIN_BATCH_SIZE=4
LR=0.0003

# ── Drift ─────────────────────────────────────────────────────────────────
DRIFT_PARTICLE_COUNT=1000
DRIFT_FORECAST_HOURS=72
DRIFT_ORIGIN_UNCERTAINTY_MINUTES=18

# ── Attribute ─────────────────────────────────────────────────────────────
ATTRIBUTION_SEARCH_RADIUS_NM=50
ATTRIBUTION_TIME_WINDOW_HOURS=6
ATTRIBUTION_FUZZY_WEIGHT=0.6
ATTRIBUTION_XGB_WEIGHT=0.4
ATTRIBUTION_XGB_PATH=
DARK_VESSEL_SAR_ENABLED=true

# ── Intel (narrative) ─────────────────────────────────────────────────────
# With no LLM reachable the service uses a deterministic template and says so
# in the response. It does not invent a narrative and present it as model output.
LLM_PROVIDER=ollama
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
# localhost, NOT host.docker.internal — the latter is a Docker-to-host alias
# and does not resolve on the Mac itself.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
LLM_MAX_RETRIES=3
LLM_TIMEOUT=60

# ── Alerts ────────────────────────────────────────────────────────────────
ALERT_RETRY_COUNT=3
ALERT_WEBHOOK_TIMEOUT=10
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ── Observability ─────────────────────────────────────────────────────────
LOG_LEVEL=INFO
PROMETHEUS_PORT=9090

# ── Ports ─────────────────────────────────────────────────────────────────
UI_PORT=3000
PORT=8000
GRAFANA_PASSWORD=admin
