# === SENTINEL Environment Configuration ===

# Database
DATABASE_URL=postgresql+asyncpg://sentinel:sentinel_secret@db:5432/sentinel
DB_USER=sentinel
DB_PASSWORD=sentinel_secret
DB_PORT=5432

# Redis
REDIS_URL=redis://redis:6379/0
REDIS_PORT=6379

# API
API_PORT=8000
API_HOST=0.0.0.0
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=1440

# Ingest
SENTINEL1_USER=
SENTINEL1_PASS=
CMEMS_USER=
CMEMS_PASS=
ERA5_API_KEY=
AIS_API_KEY=
ALLOW_SYNTHETIC_FORCING=false
INGEST_POLL_INTERVAL_MINUTES=6

# Detect
MODEL_WEIGHTS_PATH=/app/app/models/weights/unetpp_scse_best.pth
DETECT_BATCH_SIZE=4
DETECT_TILE_SIZE=512
DETECT_OVERLAP=64

# Drift
DRIFT_PARTICLE_COUNT=1000
DRIFT_FORECAST_HOURS=72
DRIFT_ORIGIN_UNCERTAINTY_MINUTES=18

# Attribute
ATTRIBUTION_SEARCH_RADIUS_NM=50
ATTRIBUTION_TIME_WINDOW_HOURS=6
DARK_VESSEL_SAR_ENABLED=true

# Intel (LLM)
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:70b
CASE_FILE_OUTPUT_DIR=/app/data/case_files

# Observability
PROMETHEUS_PORT=9090
LOG_LEVEL=INFO

# Ports
UI_PORT=3000
GRAFANA_PASSWORD=admin

# Attribution dual scoring (fuzzy + XGBoost/DuckDB)
ATTRIBUTION_FUZZY_WEIGHT=0.6
ATTRIBUTION_XGB_WEIGHT=0.4
AIS_PARQUET_PATH=/app/data/ais_demo.csv

# Detect multimodal input channels (VV,VH,U10,V10,CU,CV)
IN_CHANNELS=6

# Intel LLM retry budget
LLM_MAX_RETRIES=3

# API result cache TTL (seconds)
RESULT_TTL_SECONDS=86400
